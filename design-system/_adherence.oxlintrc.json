{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/bidding/**",
              "components/core/**",
              "components/devtools/**",
              "components/feedback/**",
              "components/forms/**",
              "components/score/**",
              "components/table/**",
              "ui_kits/mobile/**",
              "ui_kits/web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Chakra Petch|Manrope|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Chakra Petch, Manrope, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnnouncePopup'] > JSXAttribute > JSXIdentifier[name!=/^(?:taker|team|atout|contract|kind|visible|key|ref|className|style|children)$/]",
        "message": "<AnnouncePopup> doesn't accept that prop. Declared props: taker, team, atout, contract, kind, visible."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnnouncePopup'] > JSXAttribute[name.name='team'] > Literal[value!=/^(?:a|b)$/]",
        "message": "<AnnouncePopup> team must be one of 'a' | 'b'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnnouncePopup'] > JSXAttribute[name.name='atout'] > Literal[value!=/^(?:hearts|diamonds|spades|clubs|sa|ta)$/]",
        "message": "<AnnouncePopup> atout must be one of 'hearts' | 'diamonds' | 'spades' | 'clubs' | 'sa' | 'ta'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnnouncePopup'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:bid|contre|surcontre)$/]",
        "message": "<AnnouncePopup> kind must be one of 'bid' | 'contre' | 'surcontre'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnnounceEntry'] > JSXAttribute > JSXIdentifier[name!=/^(?:player|team|isRobot|kind|value|suit|round|key|ref|className|style|children)$/]",
        "message": "<AnnounceEntry> doesn't accept that prop. Declared props: player, team, isRobot, kind, value, suit, round."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnnounceEntry'] > JSXAttribute[name.name='team'] > Literal[value!=/^(?:a|b)$/]",
        "message": "<AnnounceEntry> team must be one of 'a' | 'b'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnnounceEntry'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:pass|bid|contre|surcontre)$/]",
        "message": "<AnnounceEntry> kind must be one of 'pass' | 'bid' | 'contre' | 'surcontre'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnnounceEntry'] > JSXAttribute[name.name='suit'] > Literal[value!=/^(?:hearts|diamonds|spades|clubs|sa|ta)$/]",
        "message": "<AnnounceEntry> suit must be one of 'hearts' | 'diamonds' | 'spades' | 'clubs' | 'sa' | 'ta'."
      },
      {
