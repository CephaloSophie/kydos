# =============================================================================
# Configuration de l'application mobile Kýdos Belote
# -----------------------------------------------------------------------------
# Copiez ce fichier en `mobile/.env` et renseignez VITE_API_URL.
#
# ⚠️ IMPORTANT — device Android/iOS PHYSIQUE :
#   `localhost` sur un téléphone désigne le TÉLÉPHONE, pas votre machine de dev.
#   Utilisez l'IP de votre machine sur le réseau Wi-Fi local (même réseau que le
#   téléphone). Trouvez-la avec :
#       Linux/Mac : hostname -I | awk '{print $1}'
#       Windows   : ipconfig  (champ « IPv4 Address »)
#   Exemple d'IP locale : 192.168.1.42
#
# Cas d'usage :
#   • Device physique (Wi-Fi)      → http://<IP-machine>:4000/api   ex. http://192.168.1.42:4000/api
#   • Émulateur Android (AVD)      → http://10.0.2.2:4000/api       (10.0.2.2 = « localhost de l'hôte » vu par l'émulateur)
#   • Simulateur iOS               → http://localhost:4000/api      (le simulateur partage le réseau du Mac)
#   • Navigateur (npm run dev web) → http://localhost:4000/api
#   • Production                   → https://api.kydosbelote.com/api
#
# Le socket temps réel dérive automatiquement son URL de VITE_API_URL
# (le suffixe /api est retiré). Une seule variable à régler.
# =============================================================================

VITE_API_URL=http://10.228.76.115:4000/api
