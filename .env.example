# ── Serveur (server/.env) ────────────────────────────────────────────────
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/kydos-belote
JWT_SECRET=change-moi-en-production
CORS_ORIGIN=http://localhost:5173,http://localhost:5180

# ── Application web (web/.env) ───────────────────────────────────────────
VITE_API_URL=http://localhost:4000/api

# ── Application mobile (mobile/.env) ─────────────────────────────────────
# En Cordova, pointer vers l'IP de la machine hôte (pas localhost).
VITE_API_URL=http://192.168.1.10:4000/api
