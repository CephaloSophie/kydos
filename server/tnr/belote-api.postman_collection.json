{
  "info": {
    "name": "Belote Contrée — API (TNR)",
    "_postman_id": "belote-contree-api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Tests de Non-Régression (TNR) — toutes les API REST de belote-server, montées sous /api. Lance d'abord Auth ▸ Login (enregistre {{token}}). Les créations enregistrent les IDs ({{robotId}}, {{brainId}}…) pour les requêtes suivantes."
  },
  "item": [
    {
      "name": "Auth",
      "description": "Authentification — commence ici.",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Crée un compte et renvoie un token JWT.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"email\": \"{{email}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.token) { pm.environment.set('token', d.token); console.log('token enregistré'); }",
                  "if (d.user && d.user.id) pm.environment.set('userId', d.user.id);",
                  "pm.test('status 200', () => pm.response.code === 200);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Connexion ; enregistre {{token}} et {{userId}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.token) { pm.environment.set('token', d.token); console.log('token enregistré'); }",
                  "if (d.user && d.user.id) pm.environment.set('userId', d.user.id);",
                  "pm.test('status 200', () => pm.response.code === 200);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Profil de l'utilisateur courant."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200',()=>pm.response.code===200)"
                ]
              }
            }
          ]
        }
      ]
    },
