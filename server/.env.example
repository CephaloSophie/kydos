# ============================================================================
#  belote-server — variables d'environnement (copier en .env)
# ============================================================================

# Port d'écoute de l'API + WebSocket
PORT=4000

# Base de données MongoDB.
#   - URI réelle :        mongodb://127.0.0.1:27017/belote
#   - Atlas :             mongodb+srv://user:pass@cluster.mongodb.net/belote
#   - Base EN MÉMOIRE :   mettre MONGO_URI=memory  (ou USE_MEMORY_DB=true) — utile pour tester sans Mongo
MONGO_URI=mongodb://127.0.0.1:27017/belote
USE_MEMORY_DB=false

# Secret de signature des JWT (CHANGER en production — chaîne longue et aléatoire)
JWT_SECRET=dev-secret-change-me

# Origine CORS autorisée (URL du front)
CORS_ORIGIN=http://localhost:5173

# Niveau de log : debug | info | warn | error
LOG_LEVEL=info

# --- Développement avec un device mobile physique ---
# Pour tester l'app mobile sur un téléphone, autorisez toutes les origines en dev :
#   CORS_ORIGIN=*
# (Les origines natives Capacitor sont de toute façon acceptées par défaut.)
